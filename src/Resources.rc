#include <windows.h>
#include "../include/BMP/Version.h"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION BMP_VERSION_MAJOR,BMP_VERSION_MINOR,BMP_VERSION_PATCH,0
 PRODUCTVERSION BMP_VERSION_MAJOR,BMP_VERSION_MINOR,BMP_VERSION_PATCH,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x40004L
 FILETYPE 0x2L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      BMP_COMPANY_NAME
            VALUE "FileDescription",  BMP_FILE_DESCRIPTION
            VALUE "FileVersion",      BMP_VERSION_STRING
            VALUE "InternalName",     "BMP.dll"
            VALUE "LegalCopyright",   BMP_COPYRIGHT
            VALUE "OriginalFilename", "BMP.dll"
            VALUE "ProductName",      BMP_PRODUCT_NAME
            VALUE "ProductVersion",   BMP_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
